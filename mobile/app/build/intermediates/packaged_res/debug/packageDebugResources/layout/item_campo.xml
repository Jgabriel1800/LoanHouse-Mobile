<?xml version="1.0" encoding="utf-8"?>
<!-- Um campo somente leitura do "Dados do imóvel": rótulo em negrito e valor dentro de uma caixa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/rotulo"
        style="@style/Texto.Rotulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/fundo"
        app:cardCornerRadius="@dimen/raio_botao"
        app:cardElevation="0dp"
        app:strokeColor="@color/borda"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/valor"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/botao_altura"
            android:paddingStart="@dimen/espaco"
            android:paddingEnd="@dimen/espaco" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
