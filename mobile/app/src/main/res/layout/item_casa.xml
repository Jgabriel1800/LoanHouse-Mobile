<?xml version="1.0" encoding="utf-8"?>
<!-- Card de casa do Figma, o mesmo na Home e na aba Casas (igual ao cartao-casa.js do site). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartaoCasa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/fundo"
    app:cardCornerRadius="@dimen/raio"
    app:cardElevation="0dp"
    app:strokeColor="@color/borda"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaco">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconeCasa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_casa" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/badgeSituacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textSize="@dimen/texto_base"
                android:textStyle="bold"
                tools:text="Alugada" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_codigo"
            android:textStyle="bold"
            tools:text="SAO-123" />

        <TextView
            android:id="@+id/textoEndereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_base"
            tools:text="Rua da Casa 1, 123" />

        <TextView
            android:id="@+id/textoBairro"
            style="@style/Texto.Corpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="São Pedro • Belo Jardim/PE" />

        <TextView
            android:id="@+id/textoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_grande"
            android:textStyle="bold"
            tools:text="R$ 1.200,00" />

        <!-- Badges de pendência (ou "Aluguel Pago" / "Sem Pendências"), criados no adapter -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoDetalhes"
            style="@style/Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/casa_ver_detalhes"
            app:icon="@drawable/ic_seta"
            app:iconGravity="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
